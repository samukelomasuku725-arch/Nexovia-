# GEMINI_API_KEY: Injected by Google AI Studio at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY: Secondary override for Gemini or custom AI provider
AI_API_KEY="MY_AI_API_KEY"

# AI_MODEL: Default Gemini model for learning tutor (e.g. gemini-3.8-flash, gemini-3.1-pro-preview)
AI_MODEL="gemini-3.8-flash"

# AI_API_URL: Optional custom AI endpoint or proxy URL
AI_API_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for /admin/payments panel access
ADMIN_PASSWORD="nexovian2026admin"

# SnapScan Payment link
NEXT_PUBLIC_SNAPPAY_LINK="https://pos.snapscan.io/qr/NKJJYpV6"
